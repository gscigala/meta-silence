From db01ebf2a6286b02851f8c9125ded9dadc9c4c6c Mon Sep 17 00:00:00 2001
From: Guillaume SCIGALA <guillaume.scigala@essilor.fr>
Date: Sun, 23 Feb 2025 18:43:14 +0100
Subject: [PATCH] Modifications for cross-compile

---
 .../2in15_e-Paper_G/RaspberryPi_JetsonNano/c/Makefile     | 8 ++++----
 .../RaspberryPi_JetsonNano/c/examples/EPD_2in15g_test.c   | 2 +-
 .../RaspberryPi_JetsonNano/c/lib/Config/DEV_Config.c      | 4 ++--
 3 files changed, 7 insertions(+), 7 deletions(-)

diff --git a/E-paper_Separate_Program/2in15_e-Paper_G/RaspberryPi_JetsonNano/c/Makefile b/E-paper_Separate_Program/2in15_e-Paper_G/RaspberryPi_JetsonNano/c/Makefile
index 2c81a93..a38c9af 100644
--- a/E-paper_Separate_Program/2in15_e-Paper_G/RaspberryPi_JetsonNano/c/Makefile
+++ b/E-paper_Separate_Program/2in15_e-Paper_G/RaspberryPi_JetsonNano/c/Makefile
@@ -23,12 +23,12 @@ JETSON_DEV_C = $(wildcard $(DIR_BIN)/sysfs_software_spi.o $(DIR_BIN)/sysfs_gpio.
 
 DEBUG = -D DEBUG
 
-# USELIB_RPI = USE_BCM2835_LIB
+USELIB_RPI = USE_BCM2835_LIB
 # USELIB_RPI = USE_WIRINGPI_LIB
-USELIB_RPI = USE_LGPIO_LIB
+# USELIB_RPI = USE_LGPIO_LIB
 # USELIB_RPI = USE_DEV_LIB
 
-LIB_RPI=-Wl,--gc-sections
+LIB_RPI=-Wl,--gc-sections,--hash-style=gnu
 ifeq ($(USELIB_RPI), USE_BCM2835_LIB)
 	LIB_RPI += -lbcm2835 -lm 
 else ifeq ($(USELIB_RPI), USE_WIRINGPI_LIB)
@@ -55,7 +55,7 @@ RPI:RPI_DEV RPI_epd
 JETSON: JETSON_DEV JETSON_epd
 
 TARGET = epd
-CC = gcc
+#CC = gcc
 MSG = -g -O -ffunction-sections -fdata-sections -Wall
 CFLAGS += $(MSG) -D $(EPD)
 
diff --git a/E-paper_Separate_Program/2in15_e-Paper_G/RaspberryPi_JetsonNano/c/examples/EPD_2in15g_test.c b/E-paper_Separate_Program/2in15_e-Paper_G/RaspberryPi_JetsonNano/c/examples/EPD_2in15g_test.c
index a1b6f11..b177c63 100644
--- a/E-paper_Separate_Program/2in15_e-Paper_G/RaspberryPi_JetsonNano/c/examples/EPD_2in15g_test.c
+++ b/E-paper_Separate_Program/2in15_e-Paper_G/RaspberryPi_JetsonNano/c/examples/EPD_2in15g_test.c
@@ -58,7 +58,7 @@ int EPD_2in15g_test(void)
     Paint_NewImage(BlackImage, EPD_2IN15G_WIDTH, EPD_2IN15G_HEIGHT, 0, EPD_2IN15G_WHITE);
     Paint_SetScale(4);
     Paint_SelectImage(BlackImage);
-    GUI_ReadBmp_RGB_4Color("./pic/2in15g.bmp", 0, 0);
+    GUI_ReadBmp_RGB_4Color("/etc/e-paper/2in15g.bmp", 0, 0);
     EPD_2IN15G_Display(BlackImage);
     DEV_Delay_ms(2000);
 #endif
diff --git a/E-paper_Separate_Program/2in15_e-Paper_G/RaspberryPi_JetsonNano/c/lib/Config/DEV_Config.c b/E-paper_Separate_Program/2in15_e-Paper_G/RaspberryPi_JetsonNano/c/lib/Config/DEV_Config.c
index bef6745..4c2fa73 100644
--- a/E-paper_Separate_Program/2in15_e-Paper_G/RaspberryPi_JetsonNano/c/lib/Config/DEV_Config.c
+++ b/E-paper_Separate_Program/2in15_e-Paper_G/RaspberryPi_JetsonNano/c/lib/Config/DEV_Config.c
@@ -246,9 +246,9 @@ static int DEV_Equipment_Testing(void)
 
 	printf("Current environment: ");
 #ifdef RPI
-	char systems[][9] = {"Raspbian", "Debian", "NixOS"};
+	char systems[][9] = {"Raspbian", "Debian", "NixOS", "Silence"};
 	int detected = 0;
-	for(int i=0; i<3; i++) {
+	for(int i=0; i<4; i++) {
 		if (strstr(issue_str, systems[i]) != NULL) {
 			printf("%s\n", systems[i]);
 			detected = 1;
-- 
2.48.1

