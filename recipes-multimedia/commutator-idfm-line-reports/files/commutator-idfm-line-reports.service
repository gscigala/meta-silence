[Unit]
Description=IDFM Line Reports Data Service
Requires=dbus.service connman-wait-online.service
After=dbus.service connman-wait-online.service
StartLimitBurst=0

[Service]
Type=notify
ExecStart=/usr/bin/commutator-idfm-line-reports --token %%TOKEN%%
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
